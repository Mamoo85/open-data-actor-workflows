      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/transparent_meteorite~building-permits-leads/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"cities\": [\n    \"CHI\",\n    \"SEA\",\n    \"AUS\"\n  ],\n  \"recordTypes\": [\n    \"permit\"\n  ],\n  \"sinceDays\": 7,\n  \"minValuation\": 0,\n  \"maxItems\": 5\n}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "efd03d6690b6",
      "name": "Run Apify actor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        250
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Apify API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Drop empty rows, flatten nested values so Google Sheets accepts them, cap the batch.\nconst MAX_ROWS = 500;\nconst out = [];\nfor (const item of $input.all()) {\n  const row = {};\n  let filled = 0;\n  for (const [k, v] of Object.entries(item.json)) {\n    if (v === null || v === undefined || v === '') { row[k] = ''; continue; }\n    filled++;\n    row[k] = (typeof v === 'object') ? JSON.stringify(v) : v;\n  }\n  if (filled > 0) out.push({ json: row });\n  if (out.length >= MAX_ROWS) break;\n}\nreturn out;"
      },
      "id": "36490477a642",
      "name": "Clean rows",
      "type": "n8n-nodes-base.code",
